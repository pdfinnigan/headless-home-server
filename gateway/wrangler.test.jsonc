// Fixture for `npm test` only. The real config is rendered by scripts/render-config.mjs.
{
  "name": "home-server-gateway-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "ISSUER": "https://mcp.example.com",
    "ORIGIN_URL": "https://origin.example.com",
    "ALLOWED_GITHUB_ID": "12345",
    "NAMESPACES": {
      "memory": { "tools": ["memory_recall", "memory_list", "memory_read", "memory_search", "memory_add_inbox_note"], "clients": ["oauth:claude", "oauth:chatgpt", "bearer:laptop", "bearer:bot"] },
      "mail": { "tools": ["mail_search"], "clients": ["oauth:claude", "bearer:laptop"] },
      "mcp": { "path": "/mcp", "origin": "/mcp", "tools": ["memory_read"], "clients": ["oauth:claude", "bearer:laptop"] }
    }
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "d1_databases": [{ "binding": "USAGE_DB", "database_name": "test-usage", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
