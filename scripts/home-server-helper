#!/bin/sh
# The only thing that runs as root without a password. Installed as
# /usr/local/sbin/home-server-helper (root:wheel 755) by scripts/install-helper.sh, which also
# writes /usr/local/etc/home-server/helper.conf and a NOPASSWD sudoers rule for the admin user.
#
#   home-server-helper service <name>   install or update one service from its staged copy
#   home-server-helper remove <name>    stop one service and remove its files
#   home-server-helper tunnel           install the staged tunnel config and restart cloudflared
#                                        with no gap (a second connector covers the restart)
#   home-server-helper os-update [check] install Apple's pending macOS updates, then restart if they
#                                        need it ("check" only lists them)
#   home-server-helper logs             scan and rotate the logs in /usr/local/var/log/home-server and
#                                        write their summary (local.home-server.logs runs it every 15 min)
#
# Logs: every service, job, the tunnel and the deploy watcher write to
# /usr/local/var/log/home-server/<name>.log. The folder is root's, so no service can create or swap
# files there. Each log belongs to the user that writes it, group admin, mode 640: the admin account
# can read them all without sudo, and no service can read another's.
#
# What it can do as root is narrow on purpose: create hidden non-admin service users, copy staged
# files into a service user's home, install its npm or pip dependencies there AS that user, and write
# LaunchDaemons (the service, plus any scheduled jobs) whose UserName is always a service user. So the
# admin account can make service users run code, never root. os-update adds one more power: install
# whatever updates Apple's softwareupdate offers and restart. It takes no package names or flags, so
# the worst a caller can do is restart the Mac at a bad moment.
#
# Each service runs as its own user, <SERVICE_USER>_<name> (dashes become underscores), unless its
# config entry says "user": "shared", in which case it runs as SERVICE_USER with the tunnel.
# Its own user means its own home, secrets and data: one service can't read another's.
# It reads no environment. Its settings come from the root-owned helper.conf.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 022

CONF=/usr/local/etc/home-server/helper.conf
STAGE=/usr/local/var/home-server/stage
PREFIX=local.home-server
LOGDIR=/usr/local/var/log/home-server
LOG_GROUP=admin
die() { echo "home-server-helper: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "run with sudo"
[ -f "$CONF" ] && [ ! -L "$CONF" ] || die "$CONF is missing"
[ "$(stat -f %u "$CONF")" = 0 ] || die "$CONF must be owned by root"
SERVICE_USER="$(sed -n 's/^SERVICE_USER=\([a-z_][a-z0-9_]*\)$/\1/p' "$CONF")"
[ -n "$SERVICE_USER" ] || die "SERVICE_USER missing from $CONF"
id "$SERVICE_USER" >/dev/null 2>&1 || die "service user $SERVICE_USER doesn't exist"
SVC_HOME="$(dscl . -read "/Users/$SERVICE_USER" NFSHomeDirectory | awk '{print $2}')"
[ -d "$SVC_HOME" ] && [ ! -L "$SVC_HOME" ] || die "service user's home is missing"

find_bin() { for p in /opt/homebrew/bin/$1 /usr/local/bin/$1; do [ -x "$p" ] && { echo "$p"; return 0; }; done; return 1; }
xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
as_user() { u="$1"; shift; sudo -u "$u" -H env PATH=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin "$@"; }
as_svc() { as_user "$SERVICE_USER" "$@"; }
home_of() { dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $2}'; }

# own_user <service name>: the name of that service's own account.
own_user() { printf '%s_%s' "$SERVICE_USER" "$(printf '%s' "$1" | tr - _)"; }

# ensure_user <name>: create a hidden standard account with no password and no login shell,
# the same way scripts/harden.sh creates SERVICE_USER. Refuses an existing admin.
ensure_user() {
  u="$1"
  printf '%s' "$u" | grep -Eq '^[a-z_][a-z0-9_]{0,62}$' || die "bad user name $u"
  if id "$u" >/dev/null 2>&1; then
    dseditgroup -o checkmember -m "$u" admin >/dev/null 2>&1 && die "$u is an admin; refusing to run a service as it"
    return 0
  fi
  uid=""
  for c in $(seq 401 499); do dscl . -search /Users UniqueID "$c" | grep -q . || { uid="$c"; break; }; done
  [ -n "$uid" ] || die "no free UID between 401 and 499"
  dscl . -create "/Users/$u"
  dscl . -create "/Users/$u" UniqueID "$uid"
  dscl . -create "/Users/$u" PrimaryGroupID 20   # private_group below replaces it
  dscl . -create "/Users/$u" UserShell /usr/bin/false
  dscl . -create "/Users/$u" RealName "Home server service"
  dscl . -create "/Users/$u" NFSHomeDirectory "/Users/$u"
  dscl . -create "/Users/$u" IsHidden 1
  dscl . -create "/Users/$u" Password '*'
  createhomedir -c -u "$u" >/dev/null
  echo "home-server-helper: created hidden service user $u (uid $uid)"
}

# private_group <user>: give a service user its own primary group and a home only it can open.
# In the default group (staff) it could read every 750 home on the Mac, the admin's included.
private_group() {
  u="$1"
  g="$(dscl . -read "/Groups/$u" PrimaryGroupID 2>/dev/null | awk '{print $2}')"
  if [ -z "$g" ]; then
    for c in $(id -u "$u") $(seq 401 499); do dscl . -search /Groups PrimaryGroupID "$c" | grep -q . || { g="$c"; break; }; done
    [ -n "$g" ] || die "no free group id for $u"
    dseditgroup -o create -i "$g" -r "Home server service" "$u"
  fi
  [ "$(id -g "$u")" = "$g" ] || dscl . -create "/Users/$u" PrimaryGroupID "$g"
  h="$(home_of "$u")"
  [ -d "$h" ] && [ ! -L "$h" ] || die "$u's home is missing"
  chgrp "$g" "$h"; chmod 700 "$h"
}

load_daemon() {  # load_daemon <label> <rendered plist> [nostart]
  dst="/Library/LaunchDaemons/$1.plist"
  plutil -lint "$2" >/dev/null || die "rendered plist for $1 is invalid"
  install -m 644 -o root -g wheel "$2" "$dst"
  launchctl bootout "system/$1" >/dev/null 2>&1 || true
  # bootout returns before launchd has finished tearing the job down, and a bootstrap that races
  # it fails with "5: Input/output error". Wait for the old job to go, then retry a few times.
  i=0; while launchctl print "system/$1" >/dev/null 2>&1 && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
  i=0; until err="$(launchctl bootstrap system "$dst" 2>&1)"; do
    i=$((i + 1)); [ "$i" -lt 5 ] || die "couldn't load $1: $err"
    sleep 1
  done
  # A scheduled job waits for its time (or its RunAtLoad); a service starts now.
  [ "${3:-}" = nostart ] || launchctl kickstart -k "system/$1"
}

unload_daemon() {  # unload_daemon <label>
  launchctl bootout "system/$1" >/dev/null 2>&1 || true
  rm -f "/Library/LaunchDaemons/$1.plist"
}

# remove_jobs <service> [job names to keep...]: unload that service's scheduled jobs, except those.
# Service names have no dots, so <prefix>.<service>.* never matches another service's daemons.
remove_jobs() {
  svc="$1"; shift
  for f in /Library/LaunchDaemons/"$PREFIX.$svc".*.plist; do
    [ -e "$f" ] || continue
    l="$(basename "$f" .plist)"; j="${l#"$PREFIX.$svc."}"
    case " $* " in *" $j "*) continue ;; esac
    unload_daemon "$l"
    echo "home-server-helper: removed job $svc.$j"
  done
}

# find_python <app dir>: python3.X if the app's .python-version names one, else python3 (Homebrew's).
find_python() {
  want=python3 v=3
  if [ -f "$1/.python-version" ]; then
    v="$(head -1 "$1/.python-version" | tr -d ' \r')"
    printf '%s' "$v" | grep -Eq '^3\.[0-9]{1,2}$' || die ".python-version must hold a version like 3.12"
    want="python$v"
  fi
  find_bin "$want" || die "this service needs $want, which isn't installed (brew install python@$v)"
}

# prep_log <file> <user>: make sure a log exists in LOGDIR, belongs to <user> and only it and the
# admin group can read it. Root creates it, so a launchd job opening it never makes it world-readable.
prep_log() {
  install -d -o root -g wheel -m 755 "$LOGDIR"
  [ ! -L "$1" ] || rm -f "$1"
  [ -f "$1" ] || : > "$1"
  chown "$2:$LOG_GROUP" "$1"; chmod 640 "$1"
}

valid_name() { printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,30}$'; }

cmd="${1:-}"; name="${2:-}"
case "$cmd" in
service)
  valid_name "$name" || die "bad service name"
  SRC="$STAGE/$name"
  [ -d "$SRC/app" ] && [ -f "$SRC/service.conf" ] || die "nothing staged for $name"
  [ -z "$(find "$SRC" -type l)" ] || die "staged files contain a symlink"
  RUN="$(sed -n 's/^RUN=//p' "$SRC/service.conf" | head -1)"
  PORT="$(sed -n 's/^PORT=\([0-9][0-9]*\)$/\1/p' "$SRC/service.conf" | head -1)"
  ISOLATION="$(grep -E '^ISOLATION=(own|shared)$' "$SRC/service.conf" | head -1 | cut -d= -f2)"
  MCP_PATH="$(grep -E '^MCP_PATH=/[a-z0-9][a-z0-9-]*/mcp$' "$SRC/service.conf" | head -1 | cut -d= -f2)"
  [ -n "$RUN" ] || die "RUN missing"
  [ -n "$PORT" ] && [ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] || die "PORT must be 1024-65535"
  if [ "$ISOLATION" = shared ]; then RUN_USER="$SERVICE_USER"; else RUN_USER="$(own_user "$name")"; ensure_user "$RUN_USER"; fi
  private_group "$RUN_USER"
  RUN_HOME="$(home_of "$RUN_USER")"
  [ -d "$RUN_HOME" ] && [ ! -L "$RUN_HOME" ] || die "$RUN_USER's home is missing"

  TMP="$(mktemp -d /var/tmp/home-server-helper.XXXXXX)"
  trap 'rm -rf "$TMP"' EXIT
  # mktemp makes it 700 root; the service user must be able to pass through it to run npm ci in app/.
  chmod 711 "$TMP"
  cp -R "$SRC/app" "$TMP/app"
  chown -R "$RUN_USER" "$TMP/app"
  if [ -f "$TMP/app/package-lock.json" ]; then
    NPM="$(find_bin npm)" || die "this service has a package-lock.json but npm wasn't found"
    (cd "$TMP/app" && as_user "$RUN_USER" "$NPM" ci --omit=dev --ignore-scripts --no-audit --no-fund --silent) \
      || die "npm ci failed; the running copy is unchanged"
  fi
  # Python: a virtualenv in the app folder, filled only from the lock file. Every package must match
  # its hash and be a prebuilt wheel, so nothing unpinned is downloaded and nothing compiles here.
  if [ -f "$TMP/app/requirements.lock" ]; then
    PY="$(find_python "$TMP/app")" || exit 1
    rm -rf "$TMP/app/.venv"
    as_user "$RUN_USER" "$PY" -m venv "$TMP/app/.venv" || die "couldn't create the virtualenv"
    (cd "$TMP/app" && as_user "$RUN_USER" .venv/bin/python -m pip install --require-hashes \
      --only-binary :all: --no-deps --no-input --disable-pip-version-check --quiet -r requirements.lock) \
      || die "pip install failed; the running copy is unchanged"
  fi

  install -d -o "$RUN_USER" -m 755 "$RUN_HOME/services" "$RUN_HOME/Library/Logs"
  install -d -o "$RUN_USER" -m 700 "$RUN_HOME/secrets" "$RUN_HOME/data"
  # A service that moved between its own user and the shared one: stop the old copy first.
  for h in "$SVC_HOME" "$(home_of "$(own_user "$name")")"; do
    if [ -n "$h" ] && [ "$h" != "$RUN_HOME" ] && [ -d "$h/services/$name" ] && [ ! -L "$h/services/$name" ]; then rm -rf "$h/services/$name"; fi
  done
  DST="$RUN_HOME/services/$name"
  [ ! -L "$DST" ] || die "$DST is a symlink"
  rm -rf "$DST.old"
  [ -d "$DST" ] && mv -h "$DST" "$DST.old"
  mv -h "$TMP/app" "$DST"
  rm -rf "$DST.old"

  LABEL="$PREFIX.$name"
  prep_log "$LOGDIR/$name.log" "$RUN_USER"
  cat > "$TMP/plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>UserName</key><string>$RUN_USER</string>
  <key>WorkingDirectory</key><string>$(xml "$DST")</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-c</string><string>exec $(xml "$RUN")</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>$(xml "$RUN_HOME")</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>$PORT</string>
    <key>MCP_PATH</key><string>${MCP_PATH:-/mcp}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOGDIR/$name.log</string>
  <key>StandardErrorPath</key><string>$LOGDIR/$name.log</string>
</dict>
</plist>
EOF
  load_daemon "$LABEL" "$TMP/plist"
  echo "home-server-helper: $name is running as $RUN_USER on 127.0.0.1:$PORT"

  # Scheduled jobs, one line each: JOB=<job>|<runAtLoad 0 or 1>|<HH:MM,HH:MM,...>|<command>.
  # Each runs as the service's user, in its folder, at those times in the Mac's time zone. launchd
  # runs a time missed while the Mac slept when it wakes, not one missed while it was off; runAtLoad
  # also runs it at boot and after each deploy.
  KEEP=""
  sed -n 's/^JOB=//p' "$SRC/service.conf" > "$TMP/jobs"
  while IFS= read -r line; do
    job="${line%%|*}"; rest="${line#*|}"
    load="${rest%%|*}"; rest="${rest#*|}"
    times="${rest%%|*}"; jrun="${rest#*|}"
    valid_name "$job" || die "bad job name '$job'"
    case "$load" in 0) atload=false ;; 1) atload=true ;; *) die "job $job: bad runAtLoad" ;; esac
    [ -n "$jrun" ] && [ "$jrun" != "$rest" ] || die "job $job: no command"
    cal=""
    for t in $(printf '%s' "$times" | tr , ' '); do
      printf '%s' "$t" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$' || die "job $job: bad time '$t' (use HH:MM)"
      h="${t%%:*}"; m="${t#*:}"   # 08 -> 8: launchd wants plain integers
      cal="$cal<dict><key>Hour</key><integer>${h#0}</integer><key>Minute</key><integer>${m#0}</integer></dict>"
    done
    [ -n "$cal" ] || die "job $job: no times"
    JLABEL="$LABEL.$job"
    prep_log "$LOGDIR/$name.$job.log" "$RUN_USER"
    cat > "$TMP/job.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$JLABEL</string>
  <key>UserName</key><string>$RUN_USER</string>
  <key>WorkingDirectory</key><string>$(xml "$DST")</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-c</string><string>exec $(xml "$jrun")</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>$(xml "$RUN_HOME")</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>$PORT</string>
  </dict>
  <key>StartCalendarInterval</key><array>$cal</array>
  <key>RunAtLoad</key><$atload/>
  <key>StandardOutPath</key><string>$LOGDIR/$name.$job.log</string>
  <key>StandardErrorPath</key><string>$LOGDIR/$name.$job.log</string>
</dict>
</plist>
EOF
    load_daemon "$JLABEL" "$TMP/job.plist" nostart
    KEEP="$KEEP $job"
    echo "home-server-helper: job $name.$job runs at $times"
  done < "$TMP/jobs"
  # shellcheck disable=SC2086  # one job name per word
  remove_jobs "$name" $KEEP
  ;;

remove)
  valid_name "$name" || die "bad service name"
  remove_jobs "$name"
  unload_daemon "$PREFIX.$name"
  [ -L "$SVC_HOME/services/$name" ] || rm -rf "$SVC_HOME/services/$name"
  OWN_HOME="$(home_of "$(own_user "$name")")"
  if [ -n "$OWN_HOME" ] && [ -d "$OWN_HOME/services/$name" ] && [ ! -L "$OWN_HOME/services/$name" ]; then rm -rf "$OWN_HOME/services/$name"; fi
  # The service's user, its secrets and data stay, so adding it back finds them again.
  echo "home-server-helper: removed $name (its user, secrets and data are kept)"
  ;;

tunnel)
  SRC="$STAGE/tunnel/config.yml"
  [ -f "$SRC" ] && [ ! -L "$SRC" ] || die "no staged tunnel config"
  CLOUDFLARED="$(find_bin cloudflared)" || die "cloudflared isn't installed (brew install cloudflared)"
  CF="$SVC_HOME/.cloudflared"
  [ -d "$CF" ] && [ ! -L "$CF" ] || die "$CF is missing. Run scripts/setup-tunnel.sh once first."
  ls "$CF"/*.json >/dev/null 2>&1 || die "no tunnel credentials in $CF. Run scripts/setup-tunnel.sh once first."
  install -m 600 -o "$SERVICE_USER" "$SRC" "$CF/config.yml.new"
  as_svc "$CLOUDFLARED" tunnel --config "$CF/config.yml.new" ingress validate >/dev/null \
    || { rm -f "$CF/config.yml.new"; die "cloudflared rejected the tunnel config"; }
  mv -f "$CF/config.yml.new" "$CF/config.yml"

  TMP="$(mktemp -d /var/tmp/home-server-helper.XXXXXX)"
  trap 'rm -rf "$TMP"' EXIT
  LABEL="$PREFIX.cloudflared"
  prep_log "$LOGDIR/cloudflared.log" "$SERVICE_USER"

  # Restart without a gap. Cloudflare sends a tunnel's requests to any connector that is up, so a
  # short-lived second connector starts on the new config first and carries traffic while the main
  # one restarts; it stops once the main one reports ready on its metrics port. If the second one
  # doesn't come up within 30 s, this falls back to a plain restart (a few seconds' gap).
  MAIN_METRICS=127.0.0.1:20248
  HANDOFF_METRICS=127.0.0.1:20249
  ready() { curl -fsS -m 2 "http://$1/ready" >/dev/null 2>&1; }
  wait_ready() { n=0; while [ "$n" -lt 30 ]; do ready "$1" && return 0; sleep 1; n=$((n + 1)); done; return 1; }
  HANDOFF=""
  if launchctl print "system/$LABEL" >/dev/null 2>&1; then
    as_svc "$CLOUDFLARED" tunnel --no-autoupdate --grace-period 5s --metrics "$HANDOFF_METRICS" --config "$CF/config.yml" run >/dev/null 2>&1 &
    HANDOFF=$!
    if wait_ready "$HANDOFF_METRICS"; then
      echo "home-server-helper: a second tunnel connector is carrying traffic during the restart"
    else
      echo "home-server-helper: the second connector didn't come up; restarting with a short gap"
    fi
  fi
  cat > "$TMP/plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>UserName</key><string>$SERVICE_USER</string>
  <key>ProgramArguments</key>
  <array><string>$CLOUDFLARED</string><string>tunnel</string><string>--no-autoupdate</string><string>--metrics</string><string>$MAIN_METRICS</string><string>--config</string><string>$(xml "$CF/config.yml")</string><string>run</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>$(xml "$SVC_HOME")</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOGDIR/cloudflared.log</string>
  <key>StandardErrorPath</key><string>$LOGDIR/cloudflared.log</string>
</dict>
</plist>
EOF
  load_daemon "$LABEL" "$TMP/plist"
  if [ -n "$HANDOFF" ]; then
    wait_ready "$MAIN_METRICS" || echo "home-server-helper: warning: cloudflared isn't ready after 30 s; see $LOGDIR/cloudflared.log"
    kill -TERM "$HANDOFF" 2>/dev/null || true
    wait "$HANDOFF" 2>/dev/null || true
  fi
  echo "home-server-helper: tunnel config installed and cloudflared restarted"
  ;;

os-update)
  OSLOG=/var/log/home-server-os-update.log
  case "$name" in ""|check) ;; *) die "usage: home-server-helper os-update [check]" ;; esac
  pgrep -qx softwareupdate && die "softwareupdate is already running; see $OSLOG"
  LIST="$(softwareupdate --list 2>&1)" || die "softwareupdate --list failed: $LIST"
  if ! printf '%s\n' "$LIST" | grep -q '^\* Label:'; then
    echo "home-server-helper: no macOS updates pending"
    exit 0
  fi
  echo "home-server-helper: pending updates:"
  printf '%s\n' "$LIST" | grep -A1 '^\* Label:'
  [ "$name" = check ] && exit 0
  # Detached from this session, so an SSH disconnect can't stop it halfway. The restart (when an
  # update needs one) ends any SSH session, so the caller should warn the person first.
  : > "$OSLOG"; chmod 644 "$OSLOG"
  nohup /usr/sbin/softwareupdate --install --all --agree-to-license --restart </dev/null >>"$OSLOG" 2>&1 &
  echo "home-server-helper: installing in the background (log: $OSLOG). The Mac restarts by itself if an update needs it."
  ;;

logs)
  # Every 15 min, as root (local.home-server.logs). For each log in LOGDIR:
  #  1. scan only what was written since the last run for error lines, and keep 24 h of them;
  #  2. at 1 MB, copy it to <name>.log.1.gz (5 kept) and empty it in place. launchd opens logs for
  #     appending, so the running service carries on writing to the same file;
  #  3. write summary.txt: size, restarts and last exit code from launchd, error count and the last
  #     3 error lines, redacted (no emails, IPs, tokens or long ids) and cut to 200 characters.
  # summary.txt is readable by the service user's group, so the ops service can show it in
  # server_status. The raw logs stay 640.
  [ -z "$name" ] || die "usage: home-server-helper logs"
  install -d -o root -g wheel -m 755 "$LOGDIR"
  install -d -o root -g wheel -m 700 "$LOGDIR/.state"
  MAX_BYTES=1048576 KEEP=5 SHOW=3 DAY=86400
  now="$(date +%s)"
  ERR_RE='(^|[^[:alpha:]])(error|err|errno|exception|fatal|panic|unhandled|uncaught|traceback|failed|failure|crash(ed)?|eaddrinuse|econnrefused|econnreset|etimedout)([^[:alpha:]]|$)'
  redact() {
    LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C tr '\t' ' ' | /usr/bin/perl -pe '
      s/[\w.%+-]+@[\w-]+(\.[\w-]+)+/[email]/g;
      s/\b\d{1,3}(\.\d{1,3}){3}(:\d+)?\b/[ip]/g;
      s/\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/[id]/gi;
      s/((?:pass(?:word)?|secret|token|auth(?:orization)?|bearer|api[_-]?key|cookie)["\x27]?\s*[:=]?\s*)(?:bearer\s+)?[^\s,"\x27}]+/$1\[redacted]/gi;
      s/[A-Za-z0-9_+\/=-]{24,}/[redacted]/g;
      $_ = substr($_, 0, 200) . "\n" if length($_) > 201;'
  }
  OUT="$LOGDIR/summary.txt"
  SUM="$(mktemp "$LOGDIR/.state/summary.XXXXXX")"
  printf 'generated\t%s\n' "$now" > "$SUM"
  for f in "$LOGDIR"/*.log; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    base="$(basename "$f" .log)"
    printf '%s' "$base" | grep -Eq '^[a-z0-9][a-z0-9.-]{0,62}$' || continue
    st="$LOGDIR/.state/$base"
    size="$(stat -f %z "$f")"
    off="$(cat "$st.offset" 2>/dev/null || echo 0)"
    case "$off" in ''|*[!0-9]*) off=0 ;; esac
    [ "$off" -le "$size" ] || off=0   # emptied or replaced since the last run
    # 1. New error lines, stamped with this run's time. The deploy log is test output; deploy
    #    results come from its own history, so it's only rotated.
    if [ "$base" != deploy ] && [ "$size" -gt "$off" ]; then
      tail -c "+$((off + 1))" "$f" | head -c "$((size - off))" | LC_ALL=C grep -aEi "$ERR_RE" | redact \
        | sed "s/^/$now	/" >> "$st.errors" || true
    fi
    echo "$size" > "$st.offset"
    if [ -f "$st.errors" ]; then
      awk -F '\t' -v cut="$((now - DAY))" '$1 >= cut' "$st.errors" | tail -n 500 > "$st.errors.new"
      mv -f "$st.errors.new" "$st.errors"
    fi
    count="$(cat "$st.errors" 2>/dev/null | wc -l | tr -d ' ')"
    # 2. Rotate.
    if [ "$size" -ge "$MAX_BYTES" ]; then
      rm -f "$f.$KEEP.gz"
      i=$((KEEP - 1)); while [ "$i" -ge 1 ]; do
        [ -f "$f.$i.gz" ] && mv -f "$f.$i.gz" "$f.$((i + 1)).gz"
        i=$((i - 1))
      done
      cat "$f" | gzip -c > "$f.1.gz"
      chown "root:$LOG_GROUP" "$f.1.gz"; chmod 640 "$f.1.gz"
      : > "$f"
      echo 0 > "$st.offset"
    fi
    # 3. launchd's view of the job that writes it.
    info="$(launchctl print "system/$PREFIX.$base" 2>/dev/null || true)"
    runs="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*runs = \([0-9][0-9]*\)$/\1/p' | head -1)"
    last="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*last exit code = \([^[:space:]].*\)$/\1/p' | head -1 | cut -c1-60)"
    printf 'log\t%s\t%s\t%s\t%s\t%s\t%s\n' "$base" "$size" "$(stat -f %m "$f")" "${runs:--}" "${last:--}" "$count" >> "$SUM"
    if [ -f "$st.errors" ]; then tail -n "$SHOW" "$st.errors" | sed "s/^/err	$base	/" >> "$SUM"; fi
  done
  chown "root:$(id -g "$SERVICE_USER")" "$SUM"; chmod 640 "$SUM"
  mv -f "$SUM" "$OUT"
  ;;

*) die "usage: home-server-helper service <name> | remove <name> | tunnel | os-update [check] | logs" ;;
esac
